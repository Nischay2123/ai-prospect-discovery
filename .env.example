# --- LLM gateway (LiteLLM): any provider, set by model string. Defaults use free API keys. ---
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=groq/openai/gpt-oss-20b
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional paid providers, e.g. LLM_MODEL=anthropic/claude-haiku-5-5 or openai/gpt-6-luna
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=6
LLM_NUM_RETRIES=0

# --- Discovery sources ---
# serper.dev, 2,500 free queries: Google results for site: searches
SERPER_API_KEY=
# optional fallback search provider
BRAVE_API_KEY=
# Google Cloud console -> YouTube Data API v3
YOUTUBE_API_KEY=

# --- Behaviour ---
ENABLED_PLATFORMS=Google,LinkedIn,X,YouTube,Instagram,Facebook,Threads
REQUEST_DEADLINE_SECONDS=30
PLATFORM_TIMEOUT_SECONDS=12
CLIENT_RATE_LIMIT_PER_MINUTE=10
# set on any public deployment; clients then send X-API-Key
API_KEY=

# --- Storage and observability ---
DB_PATH=data/prospects.db
RETENTION_DAYS=7
# optional: send traces to the Logfire UI (console output works without it)
LOGFIRE_TOKEN=
